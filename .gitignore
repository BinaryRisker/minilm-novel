node_modules/
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# 跑测试时的临时探针文件（退出码 / git 状态转储 / 诊断日志），不入库
dev/exit_*.txt
dev/g_*.txt
dev/g*.txt
dev/c*.txt
dev/diag*.txt
dev/r_*.txt
dev/e.txt
dev/sz.txt

# 公版语料抓取：原始下载缓存与逐作品副本都不入库（可由 py/data/fetch_corpus.py 重建）
# 入库的是聚合后的 py/data/corpus.json 与审计 data/sources.json
data/raw/
data/processed/
# 按作品切分的训练语料（可由 py/data/build_splits.py 重建），只入库 data/split_report.json 审计
data/splits/*.txt

# 语料来源探索的临时探针（古腾堡 / 汉川草庐 / 维基文库的中间产物）
dev/gb_zh.html
dev/gutendex_zh.json
dev/t_pg24099.txt
dev/tree_*.json

# 语料改写前的本地备份（原 7360 字种子语料）；可从 git 历史恢复，不入库
py/data/corpus.orig.json

# dev/loop/：验证脚本（verify_resume / verify_seed / 循环训练）的中途 checkpoint 与工作目录。
# 体积大（实测 13 MB+）且可由脚本重建，不入库；dev/verify/*.json 是报告，保留入库。
dev/loop/

# 预编码分片（py/novellm/dataset.py 产出）：全量 24.5 亿字 ≈4.6GiB，可由 build 命令重建
py/runs/shards/

# 模型权重 checkpoint（*.pt）：体积大（实测 t30m 单个 306MB），可由训练脚本重建；
# 入库的是同目录的 meta.json / itos.json / report.md 等文字产物
*.pt

# AutoDL 集成：实例连接信息只留本地；数据包/回传产物不入库
dev/autodl/instance.local.sh
dist/remote/

# 双 agent 协作协议（.collab/）：schema / 任务定义共享，运行时状态留本地
# 入库：.collab/protocol.json（协议）、.collab/tasks/*.json（任务定义）
# 不入库：.collab/status/*（本地状态）、.collab/inbox/*（未读消息）
#          .collab/outbox/*（已发但未归档）、.collab/locks/*（短期锁文件）
#          .collab/log/*（运行日志）
.collab/status/
.collab/inbox/
.collab/outbox/
.collab/locks/
.collab/log/
